{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "indentStyle": "space",
    "bracketSpacing": false
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "json": {},
  "linter": {
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  }
}
