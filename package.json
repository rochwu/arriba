{
  "name": "arriba",
  "version": "0.0.0",
  "description": "It goes up",
  "homepage": "https://rochwu.github.io/arriba",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "bun ./index.html",
    "build": "bun build ./index.html --outdir dist --production",
    "check-types": "tsc --noEmit",
    "clean-branches": "git branch | grep -v \"main\" | xargs git branch -D",
    "format": "biome format --write .",
    "lint": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@floating-ui/dom": "^1.8.0",
    "@phosphor-icons/react": "^2.1.10",
    "immer": "^11.2.9",
    "lodash-es": "^4.18.1",
    "normalize.css": "^8.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  }
}
